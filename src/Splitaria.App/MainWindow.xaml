<Window x:Class="Splitaria.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:core="clr-namespace:Splitaria.Core;assembly=Splitaria.Core"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Splitaria" Width="1040" Height="680" MinWidth="1040" MinHeight="680"
        Icon="pack://application:,,,/assets/brand/Splitaria.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}" StateChanged="Window_StateChanged" SourceInitialized="Window_SourceInitialized"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="9" GlassFrameThickness="1" CornerRadius="9" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="Transparent" BorderThickness="0">
            <Grid>
                <Button x:Name="BrandMenuButton" Height="34" Margin="12,5,0,0" Padding="7,5,11,5"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource GhostButtonStyle}"
                        Click="BrandMenu_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Header="Preferências" Click="Preferences_Click" />
                            <MenuItem Header="Sobre o Splitaria" Click="About_Click" />
                            <Separator />
                            <MenuItem Header="Sair" Click="Exit_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/assets/brand/splitaria-mark-64.png" Width="24" Height="24" Margin="0,0,8,0" />
                        <TextBlock Text="Splitaria" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text=" · " FontSize="13" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="TopVersionText" FontSize="13" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButtonStyle}" ToolTip="Minimizar" Click="Minimize_Click">
                        <Path Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" Width="10" Height="1" Stretch="Fill" SnapsToDevicePixels="True" />
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}" ToolTip="Maximizar" Click="MaximizeRestore_Click">
                        <Grid Width="12" Height="12">
                            <Border x:Name="MaximizeIcon" Width="10" Height="10" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                    BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Canvas x:Name="RestoreIcon" Width="12" Height="12" Visibility="Collapsed">
                                <Border Canvas.Left="3" Canvas.Top="1" Width="8" Height="8" BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1.1" />
                                <Border Canvas.Left="1" Canvas.Top="3" Width="8" Height="8" Background="{DynamicResource WindowBackgroundBrush}"
                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" BorderThickness="1.1" />
                            </Canvas>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButtonStyle}" ToolTip="Fechar" Click="CloseWindow_Click">
                        <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" Width="10" Height="10" Stretch="Fill" SnapsToDevicePixels="True" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,4,18,18">
            <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border x:Name="SourceDropZone" Grid.Row="0" Background="Transparent" BorderThickness="0" Padding="12,10,12,18" Margin="0,0,0,4"
                            AllowDrop="True" DragEnter="SourceDropZone_DragEnter" DragOver="SourceDropZone_DragOver"
                            DragLeave="SourceDropZone_DragLeave" Drop="SourceDropZone_Drop">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Pastas de origem" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Adicione uma ou mais pastas para organizar juntas." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,14" />
                            </StackPanel>
                            <ListBox Grid.Row="1" x:Name="SourceFoldersList" MinHeight="76" BorderThickness="0" Background="{DynamicResource ControlBackgroundBrush}"
                                     Padding="5" SelectionMode="Extended" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Content="×" FontSize="18" FontWeight="Normal"
                                                    Padding="3" Margin="0" ToolTip="Remover esta pasta" Tag="{Binding}" Click="RemoveSourceItem_Click" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,7" /><Setter Property="Margin" Value="1" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template"><Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource InfoBackgroundBrush}" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value></Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                             </ListBox>
                            <Border x:Name="SourceDropOverlay" Grid.Row="1" Visibility="Collapsed" IsHitTestVisible="False"
                                    Background="{DynamicResource InfoBackgroundBrush}" BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="2" CornerRadius="8" Margin="0" Opacity="0.96">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="↓" FontSize="24" Foreground="{DynamicResource InfoTextBrush}" HorizontalAlignment="Center" />
                                    <TextBlock Text="Solte as pastas aqui" FontWeight="SemiBold" Foreground="{DynamicResource InfoTextBrush}" Margin="0,5,0,0" />
                                    <TextBlock Text="Você pode adicionar várias de uma vez" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <Grid Grid.Row="2" Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox x:Name="SubfoldersCheckBox" Content="Incluir subpastas" IsChecked="True" Margin="3,0,12,0" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="＋  Adicionar" Padding="12,8" Margin="0" Click="ChooseSource_Click" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="0,1,0,0" Padding="12,20,12,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,13">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButtonStyle}" Width="34" Height="34" Padding="7" Margin="4,0,0,0"
                                        ToolTip="Restaurar destinos padrão" Click="UseDefaults_Click">
                                    <Viewbox Width="17" Height="17">
                                        <Path Data="M 17.65,6.35 C 16.2,4.9 14.21,4 12,4 C 7.58,4 4,7.58 4,12 C 4,16.42 7.58,20 12,20 C 15.73,20 18.84,17.45 19.73,14 L 17.65,14 C 16.83,16.33 14.61,18 12,18 C 8.69,18 6,15.31 6,12 C 6,8.69 8.69,6 12,6 C 13.66,6 15.14,6.69 16.22,7.78 L 13,11 L 20,11 L 20,4 Z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Viewbox>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="Destinos" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Onde salvar fotos e vídeos." FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="NoWrap" Margin="0,4,4,0" />
                                </StackPanel>
                            </DockPanel>

                            <TextBlock Text="Fotos" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="1,2,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="PhotoDestinationTextBox" IsReadOnly="True" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Padding="0" Margin="2,0,0,0" ToolTip="Alterar pasta de fotos" Click="ChoosePhotoDestination_Click">
                                    <Path Data="M 1,4 L 7,4 L 9,6 L 19,6 L 19,17 L 1,17 Z" Stroke="#62626D" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="15" Stretch="Fill" />
                                </Button>
                            </Grid>
                            <TextBlock Text="Vídeos" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="1,12,0,5" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="VideoDestinationTextBox" IsReadOnly="True" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}" Padding="0" Margin="2,0,0,0" ToolTip="Alterar pasta de vídeos" Click="ChooseVideoDestination_Click">
                                    <Path Data="M 1,4 L 7,4 L 9,6 L 19,6 L 19,17 L 1,17 Z" Stroke="#62626D" StrokeThickness="1.5" Fill="Transparent" Width="18" Height="15" Stretch="Fill" />
                                </Button>
                            </Grid>

                            <Border Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="8" Padding="11" Margin="0,14,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="ⓘ" Foreground="{DynamicResource InfoTextBrush}" Margin="0,0,8,0" />
                                    <TextBlock Text="Os originais sempre serão preservados." Foreground="{DynamicResource InfoTextBrush}" FontSize="12" />
                                </StackPanel>
                            </Border>
                            <Button x:Name="AnalyzeButton" Content="Analisar arquivos" HorizontalAlignment="Stretch" Margin="0,4,0,0" Click="Analyze_Click" />
                        </StackPanel>
                    </Border>
            </Grid>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="205" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="0,0,0,1" Padding="20,16,20,13">
                        <Grid>
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="Revisão dos arquivos" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock x:Name="SummaryText" Text="Escolha as pastas e analise para montar a prévia." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                              BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource SoftBorderBrush}"
                              VerticalGridLinesBrush="Transparent" HeadersVisibility="Column" SelectionMode="Single"
                              SelectionChanged="FilesGrid_SelectionChanged" RowHeight="46" ColumnHeaderHeight="38"
                              Background="{DynamicResource SurfaceBrush}" CanUserSortColumns="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Resources>
                            <Style x:Key="GridTextStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                <Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" /><Setter Property="BorderBrush" Value="{DynamicResource SoftBorderBrush}" />
                                <Setter Property="Padding" Value="10,0" /><Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template"><Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                            <DockPanel LastChildFill="True">
                                                <TextBlock x:Name="SortGlyph" DockPanel.Dock="Right" Text="↕" Foreground="#AAAAB3" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="SortDirection" Value="Ascending"><Setter TargetName="SortGlyph" Property="Text" Value="↑" /><Setter TargetName="SortGlyph" Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                                            <Trigger Property="SortDirection" Value="Descending"><Setter TargetName="SortGlyph" Property="Text" Value="↓" /><Setter TargetName="SortGlyph" Property="Foreground" Value="{StaticResource AccentBrush}" /></Trigger>
                                            <Trigger Property="CanUserSort" Value="False"><Setter TargetName="SortGlyph" Property="Visibility" Value="Collapsed" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value></Setter>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="3,0,0,0" />
                                <Setter Property="ToolTip" Value="Arquivo pronto para copiar" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBackgroundBrush}" /></DataTrigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="BorderBrush" Value="{StaticResource SecondaryBrush}" /></Trigger>
                                    <DataTrigger Binding="{Binding DuplicateKind}" Value="{x:Static core:DuplicateKind.InSource}"><Setter Property="ToolTip" Value="Mesmo conteúdo encontrado em mais de uma origem" /></DataTrigger>
                                    <DataTrigger Binding="{Binding DuplicateKind}" Value="{x:Static core:DuplicateKind.IdenticalAtDestination}"><Setter Property="ToolTip" Value="Cópia idêntica já existente no destino" /></DataTrigger>
                                    <DataTrigger Binding="{Binding DuplicateKind}" Value="{x:Static core:DuplicateKind.NameConflictAtDestination}"><Setter Property="ToolTip" Value="Outro arquivo utiliza esse nome no destino" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="9,0" />
                                <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="48" CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox ToolTip="Selecionar ou desmarcar todos" Click="HeaderSelectAll_Click" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ARQUIVO" Binding="{Binding Name}" SortMemberPath="Name" Width="*" MinWidth="190" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding SourcePath}" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="TIPO" Binding="{Binding TypeLabel}" SortMemberPath="TypeLabel" Width="70" IsReadOnly="True"
                                                ElementStyle="{StaticResource GridTextStyle}" />
                            <DataGridTextColumn Header="DATA" Binding="{Binding DateLabel}" SortMemberPath="Date" Width="92" IsReadOnly="True"
                                                ElementStyle="{StaticResource GridTextStyle}" />
                            <DataGridTextColumn Header="DATA OBTIDA DE" Binding="{Binding DateSource}" SortMemberPath="DateSource" Width="125" IsReadOnly="True"
                                                ElementStyle="{StaticResource GridTextStyle}" />
                            <DataGridTemplateColumn Header="SITUAÇÃO" SortMemberPath="DuplicateKind" Width="170" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="StatusDot" Text="●" Foreground="{DynamicResource SuccessTextBrush}" FontSize="10" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock x:Name="StatusLabel" Text="{Binding StatusLabel}" Foreground="{DynamicResource SuccessTextBrush}" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding HasDuplicateIssue}" Value="True"><Setter TargetName="StatusDot" Property="Foreground" Value="{DynamicResource WarningTextBrush}" /><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource WarningTextBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding DuplicateKind}" Value="{x:Static core:DuplicateKind.IdenticalAtDestination}"><Setter TargetName="StatusDot" Property="Foreground" Value="{DynamicResource ErrorTextBrush}" /><Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource ErrorTextBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="StatusDot" Property="Foreground" Value="{DynamicResource SelectionStatusBrush}" />
                                                <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource SelectionStatusBrush}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border x:Name="PreviewPanel" Grid.Row="2" Margin="18,12,18,12" Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="260" /><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource ControlBackgroundBrush}" CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                                    ToolTip="Clique para ampliar" MouseLeftButtonUp="Preview_Click">
                                <Grid>
                                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="5" />
                                    <vlc:VideoView x:Name="PreviewVideo" Margin="5" Visibility="Collapsed">
                                        <Border Background="#01000000" Cursor="Hand" ToolTip="Clique para ampliar"
                                                MouseLeftButtonUp="Preview_Click" />
                                    </vlc:VideoView>
                                    <TextBlock x:Name="PreviewPlaceholder" Text="Selecione um arquivo para visualizar" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock x:Name="SelectedNameText" Text="Nenhum arquivo selecionado" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,9" />
                                <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="◷" Foreground="{DynamicResource MutedTextBrush}" Width="24" /><TextBlock x:Name="SelectedDateText" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="↖" Foreground="{DynamicResource MutedTextBrush}" Width="24" /><TextBlock x:Name="SelectedSourceText" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="↘" Foreground="{DynamicResource MutedTextBrush}" Width="24" /><TextBlock x:Name="SelectedDestinationText" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3"><TextBlock Text="◇" Foreground="{DynamicResource MutedTextBrush}" Width="24" /><TextBlock x:Name="SelectedDuplicateText" Foreground="{DynamicResource SuccessTextBrush}" TextTrimming="CharacterEllipsis" /></StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="CompletionPanel" Grid.Row="2" Visibility="Collapsed" Margin="18,12,18,12"
                            Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource SoftBorderBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="18,14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource InfoBackgroundBrush}" Margin="0,0,11,0">
                                        <TextBlock Text="✓" Foreground="{DynamicResource InfoTextBrush}" FontSize="17" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Organização concluída" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock x:Name="CompletionSubtitleText" Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GhostButtonStyle}"
                                        Width="32" Height="32" Padding="0" Margin="0" Content="×" FontSize="18"
                                        ToolTip="Voltar à visualização" Click="CloseCompletion_Click" />
                            </Grid>
                            <Grid Grid.Row="1" Margin="43,11,43,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel><TextBlock x:Name="CopiedCountText" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Copiados" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock x:Name="PhotoCountText" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Fotos" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock x:Name="VideoCountText" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Vídeos" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel>
                                <StackPanel Grid.Column="3"><TextBlock x:Name="SkippedFailedCountText" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Ignorados · falhas" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" /></StackPanel>
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="OpenPhotosButton" Content="Ver fotos" Margin="4,0" Padding="15,8" Click="OpenPhotos_Click" />
                                <Button x:Name="OpenVideosButton" Content="Ver vídeos" Margin="4,0" Padding="15,8" Click="OpenVideos_Click" />
                                <Button Style="{StaticResource PrimaryButtonStyle}" Margin="4,0,0,0" Padding="17,8" Click="NewOrganization_Click">
                                    <TextBlock Text="Nova organização" FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="0,1,0,0" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="2,0,24,0">
                                 <StackPanel Orientation="Horizontal">
                                     <TextBlock Text="●" Foreground="#52A66C" FontSize="10" Margin="0,0,7,0" />
                                     <TextBlock x:Name="StatusText" Text="Pronto para analisar" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                                 </StackPanel>
                                <TextBlock x:Name="SpaceStatusText" Text="O espaço necessário será calculado após a análise."
                                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                                 <ProgressBar x:Name="ProgressBar" Height="4" Minimum="0" Maximum="100" Margin="0,8,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="OrganizeButton" Style="{StaticResource PrimaryButtonStyle}"
                                    IsEnabled="False" MinWidth="190" Click="Organize_Click">
                                <TextBlock Text="Organizar selecionados" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
