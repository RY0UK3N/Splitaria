<Window x:Class="Splitaria.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sobre o Splitaria" Width="510" Height="570"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        Icon="pack://application:,,,/assets/brand/splitaria-mark-64.png"
        Background="{DynamicResource WindowBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0" GlassFrameThickness="1"
                                  CornerRadius="9" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Width="22" Height="22" Source="pack://application:,,,/assets/brand/splitaria-mark-64.png" Margin="0,0,9,0" />
                <TextBlock Text="Sobre o Splitaria" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Style="{StaticResource CloseCaptionButtonStyle}" ToolTip="Fechar"
                    Click="Close_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" Width="10" Height="10" Stretch="Fill" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="24,12,24,24">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="26">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                        <Image Width="58" Height="58" Source="pack://application:,,,/assets/brand/splitaria-mark-64.png" Margin="0,0,16,0" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Splitaria" FontSize="25" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Organize suas fotos e vídeos localmente, preservando os arquivos originais."
                               TextWrapping="Wrap" FontSize="14" LineHeight="21" />
                    <Border Background="{DynamicResource InfoBackgroundBrush}" CornerRadius="8" Padding="13" Margin="0,18,0,20">
                        <TextBlock Text="Seus arquivos permanecem no computador. O Splitaria não envia fotos ou vídeos para a internet."
                                   Foreground="{DynamicResource InfoTextBrush}" TextWrapping="Wrap" LineHeight="19" />
                    </Border>

                    <TextBlock Text="Licença do Splitaria" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="Código aberto sob a licença MIT. Copyright © 2026 Marcos Luciano Tagliari Junior."
                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="19" />

                    <Separator Margin="0,20,0,18" />

                    <TextBlock Text="Componentes de terceiros" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="A reprodução de vídeos utiliza LibVLCSharp e libVLC, disponibilizados sob a GNU LGPL 2.1 ou posterior."
                               Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" LineHeight="19" />
                    <Button Content="Ver avisos e licenças" HorizontalAlignment="Left" Margin="-4,13,0,0" Click="OpenNotices_Click" />
                </StackPanel>
            </Border>
            <Button Grid.Row="1" Content="Fechar" Width="104" HorizontalAlignment="Right" Margin="0,18,0,0" Click="Close_Click" />
        </Grid>
    </Grid>
</Window>
