<Window x:Class="Splitaria.App.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Preferências — Splitaria" Width="564" Height="594"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        Icon="pack://application:,,,/assets/brand/splitaria-mark-64.png"
        AllowsTransparency="True" Background="Transparent">
    <Border Margin="12" CornerRadius="12" Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.24" Color="#000000" />
        </Border.Effect>
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Width="22" Height="22" Source="pack://application:,,,/assets/brand/splitaria-mark-64.png" Margin="0,0,9,0" />
                <TextBlock Text="Preferências" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Style="{StaticResource CloseCaptionButtonStyle}" ToolTip="Fechar"
                    Click="Cancel_Click">
                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" Width="10" Height="10" Stretch="Fill" />
            </Button>
        </Grid>
        <Grid Grid.Row="1" Margin="24,12,24,24">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="24">
            <StackPanel>
                <TextBlock Text="Tema" FontWeight="SemiBold" />
                <ComboBox x:Name="ThemeCombo" Margin="0,7,0,20" Height="38" SelectionChanged="ThemeCombo_SelectionChanged">
                    <ComboBoxItem Content="Seguir o Windows" Tag="System" />
                    <ComboBoxItem Content="Claro" Tag="Light" />
                    <ComboBoxItem Content="Escuro" Tag="Dark" />
                </ComboBox>

                <CheckBox x:Name="AutoPlayCheck" Content="Reproduzir vídeos automaticamente no preview" Margin="0,0,0,20" />

                <TextBlock Text="Organização das pastas" FontWeight="SemiBold" />
                <ComboBox x:Name="FolderPatternCombo" Margin="0,7,0,7" Height="38">
                    <ComboBoxItem Content="Ano / mês com nome — 2026 / 03 - Março" Tag="YearAndNamedMonth" />
                    <ComboBoxItem Content="Ano / mês numérico — 2026 / 03" Tag="YearAndNumericMonth" />
                    <ComboBoxItem Content="Somente ano — 2026" Tag="YearOnly" />
                </ComboBox>
                <TextBlock Text="A alteração será usada na próxima análise." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,22" />

                <Separator Background="{DynamicResource SoftBorderBrush}" Margin="0,0,0,18" />
                <Button x:Name="UpdateButton" Content="Verificar atualizações" HorizontalAlignment="Left" Margin="0" Click="CheckUpdates_Click" />
                <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,9,0,0" TextWrapping="Wrap" />
            </StackPanel>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" Width="96" Click="Cancel_Click" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Width="110" Click="Save_Click">
                    <TextBlock Text="Salvar" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
