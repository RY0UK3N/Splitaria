<Window x:Class="Splitaria.App.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Preferências — Splitaria" Width="590" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        Icon="pack://application:,,,/assets/brand/Splitaria.ico"
        AllowsTransparency="True" Background="Transparent">
    <Border Margin="12" CornerRadius="12" Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.24" Color="#000000" />
        </Border.Effect>
    <Grid ClipToBounds="True">
        <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Width="22" Height="22" Source="pack://application:,,,/assets/brand/splitaria-mark-64.png" Margin="0,0,9,0" />
                <TextBlock Text="Preferências" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Style="{StaticResource CloseCaptionButtonStyle}" ToolTip="Fechar"
                    Click="Cancel_Click">
                <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1" Width="10" Height="10" Stretch="Fill" />
            </Button>
        </Grid>
        <Grid Grid.Row="1" Margin="24,12,24,24">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Tema" FontWeight="SemiBold" />
                <ComboBox x:Name="ThemeCombo" Margin="0,7,0,20" Height="38" SelectionChanged="ThemeCombo_SelectionChanged">
                    <ComboBoxItem Content="Seguir o Windows" Tag="System" />
                    <ComboBoxItem Content="Claro" Tag="Light" />
                    <ComboBoxItem Content="Escuro" Tag="Dark" />
                </ComboBox>

                <CheckBox x:Name="AutoPlayCheck" Content="Reproduzir vídeos automaticamente no preview" Margin="0,0,0,20" />

                <TextBlock Text="Organização das pastas" FontWeight="SemiBold" />
                <ComboBox x:Name="FolderPatternCombo" Margin="0,7,0,7" Height="38">
                    <ComboBoxItem Content="Ano / mês com nome — 2026 / 03 - Março" Tag="YearAndNamedMonth" />
                    <ComboBoxItem Content="Ano / mês numérico — 2026 / 03" Tag="YearAndNumericMonth" />
                    <ComboBoxItem Content="Somente ano — 2026" Tag="YearOnly" />
                    <ComboBoxItem Content="Ano / ano-mês — 2026 / 2026-03" Tag="YearAndYearMonth" />
                    <ComboBoxItem Content="Ano / data completa — 2026 / 2026-03-08" Tag="YearAndFullDate" />
                    <ComboBoxItem Content="Ano-mês com nome na raiz — 2026-03 - Março" Tag="FlatYearAndNamedMonth" />
                    <ComboBoxItem Content="Ano-mês na raiz — 2026-03" Tag="FlatYearAndNumericMonth" />
                </ComboBox>
                <TextBlock Text="A alteração será usada na próxima análise." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,18" />

                <Separator Background="{DynamicResource SoftBorderBrush}" Margin="0,0,0,16" />
                <TextBlock Text="Atualizações" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Border Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource SoftBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Versão instalada" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="InstalledVersionText" Grid.Column="1" FontWeight="SemiBold" />
                        </Grid>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Versão disponível" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock x:Name="AvailableVersionText" Grid.Column="1" Text="Não verificada" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="UpdateButton" Content="Verificar atualizações" Click="CheckUpdates_Click" />
                            <Button Content="Abrir no GitHub" Margin="8,0,0,0" Click="OpenRepository_Click" />
                        </StackPanel>
                        <TextBlock x:Name="UpdateStatusText" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,9,0,0" TextWrapping="Wrap" />
                        <Border x:Name="ReleaseNotesPanel" Margin="0,12,0,0" Padding="12"
                                Background="{DynamicResource ControlBackgroundBrush}"
                                BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:Name="ReleaseNotesTitle" FontSize="12" FontWeight="SemiBold" />
                                <TextBlock x:Name="ReleaseNotesText" Margin="0,7,0,0" FontSize="12"
                                           Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="UpdateActionsPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                            <Button x:Name="InstallUpdateButton" Style="{StaticResource PrimaryButtonStyle}" Click="InstallUpdate_Click">
                                <TextBlock Text="Baixar e instalar" FontWeight="SemiBold"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button Content="Notas da versão" Margin="8,0,0,0" Click="OpenReleaseNotes_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancelar" Width="96" Click="Cancel_Click" />
                <Button Style="{StaticResource PrimaryButtonStyle}" Width="110" Click="Save_Click">
                    <TextBlock Text="Salvar" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
    </Border>
</Window>
