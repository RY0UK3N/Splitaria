<Window x:Class="Splitaria.App.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Visualização" Width="1120" Height="760" MinWidth="720" MinHeight="520"
        Icon="pack://application:,,,/assets/brand/splitaria-mark-64.png"
        WindowStartupLocation="CenterOwner" Background="#16161A" KeyDown="Window_KeyDown" MouseMove="Window_MouseMove"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
    <Window.Resources>
        <Style x:Key="MediaSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20" /><Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="20" VerticalAlignment="Center">
                        <primitives:Track x:Name="PART_Track" VerticalAlignment="Center">
                            <primitives:Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#6F69EC" CornerRadius="2" /></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </primitives:Track.DecreaseRepeatButton>
                            <primitives:Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#55555E" CornerRadius="2" /></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </primitives:Track.IncreaseRepeatButton>
                            <primitives:Track.Thumb>
                                <Thumb Width="13" Height="13">
                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="White" Stroke="#6F69EC" StrokeThickness="2" /></ControlTemplate></Thumb.Template>
                                </Thumb>
                            </primitives:Track.Thumb>
                        </primitives:Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="22">
            <Image x:Name="LargeImage" Stretch="Uniform" />
            <vlc:VideoView x:Name="LargeVideo" Visibility="Collapsed">
                <Border Background="#01000000" MouseMove="Window_MouseMove" />
            </vlc:VideoView>
            <TextBlock x:Name="ErrorText" Foreground="#C9C9D0" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>
        <Border x:Name="ControlsBar" Grid.Row="1" Background="#F0202026" Padding="18,10">
            <StackPanel>
                <Grid x:Name="VideoControlsPanel" Visibility="Collapsed" Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="86" /><ColumnDefinition Width="*" /><ColumnDefinition Width="112" /></Grid.ColumnDefinitions>
                    <Button x:Name="PlayPauseButton" Style="{StaticResource GhostButtonStyle}" Margin="0,0,10,0" Padding="8,5" Click="PlayPause_Click">
                        <TextBlock x:Name="PlayPauseText" Text="Pausar" Foreground="White" FontWeight="SemiBold" />
                    </Button>
                    <Slider Grid.Column="1" x:Name="TimelineSlider" Style="{StaticResource MediaSliderStyle}" Minimum="0" Maximum="1"
                            ValueChanged="TimelineSlider_ValueChanged" />
                    <TextBlock Grid.Column="2" x:Name="TimeText" Text="00:00 / 00:00" Foreground="#D4D4DA" FontSize="12"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="105" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="PathText" Foreground="#AFAFB8" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,18,0" />
                    <Button Grid.Column="1" x:Name="MuteButton" Style="{StaticResource GhostButtonStyle}" Margin="0" Padding="8,4"
                            Visibility="Collapsed" ToolTip="Ativar ou silenciar áudio" Click="Mute_Click">
                        <TextBlock x:Name="MuteText" Text="Som" Foreground="White" FontWeight="SemiBold" />
                    </Button>
                    <Slider Grid.Column="2" x:Name="VolumeSlider" Style="{StaticResource MediaSliderStyle}" Minimum="0" Maximum="100"
                            Visibility="Collapsed" ValueChanged="VolumeSlider_ValueChanged" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
