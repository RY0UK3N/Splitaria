<Window x:Class="Splitaria.App.DuplicateActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Arquivos existentes — Splitaria" Width="520" Height="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        Icon="pack://application:,,,/assets/brand/Splitaria.ico"
        AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style x:Key="DuplicateChoiceStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="ChoiceBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Grid Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse x:Name="SelectionRing" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" />
                                <Ellipse x:Name="SelectionDot" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ChoiceBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ChoiceBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="ChoiceBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="SelectionRing" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="SelectionDot" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Margin="12" CornerRadius="12" Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource SoftBorderBrush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.24" Color="#000000" />
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Width="22" Height="22" Source="pack://application:,,,/assets/brand/splitaria-mark-64.png" Margin="0,0,9,0" />
                    <TextBlock Text="Arquivos existentes" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button HorizontalAlignment="Right" Style="{StaticResource CloseCaptionButtonStyle}" ToolTip="Fechar" Click="Cancel_Click">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1" Width="10" Height="10" Stretch="Fill" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="24,12,24,24">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="24,22">
                    <StackPanel>
                        <TextBlock Text="Como tratar os duplicados?" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="DescriptionText" Margin="0,7,0,20" Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />

                        <RadioButton x:Name="KeepBothOption" GroupName="DuplicateAction" Style="{StaticResource DuplicateChoiceStyle}"
                                     Tag="KeepBoth" Margin="0,0,0,9" Checked="Choice_Checked">
                            <StackPanel>
                                <TextBlock Text="Criar cópia" FontWeight="SemiBold" />
                                <TextBlock Text="Mantém o arquivo existente e cria nomes como foto (2).jpg."
                                           FontSize="12" Margin="0,3,30,0" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="DuplicateAction" Style="{StaticResource DuplicateChoiceStyle}"
                                     Tag="Replace" Margin="0,0,0,9" Checked="Choice_Checked">
                            <StackPanel>
                                <TextBlock Text="Substituir" FontWeight="SemiBold" />
                                <TextBlock Text="Troca o arquivo que já está no destino pelo item selecionado."
                                           FontSize="12" Margin="0,3,30,0" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton GroupName="DuplicateAction" Style="{StaticResource DuplicateChoiceStyle}"
                                     Tag="Skip" Checked="Choice_Checked">
                            <StackPanel>
                                <TextBlock Text="Ignorar" FontWeight="SemiBold" />
                                <TextBlock Text="Não copia os arquivos duplicados ou com nomes em conflito."
                                           FontSize="12" Margin="0,3,30,0" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Content="Cancelar" Width="100" Click="Cancel_Click" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButtonStyle}" Width="110"
                            IsEnabled="False" Click="Confirm_Click">
                        <TextBlock Text="Confirmar" FontWeight="SemiBold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
