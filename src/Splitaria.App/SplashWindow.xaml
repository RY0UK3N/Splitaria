<Window x:Class="Splitaria.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="570" Height="350" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <Grid Background="#17171D">
        <Grid.Clip>
            <RectangleGeometry Rect="1,1,568,348" RadiusX="18" RadiusY="18" />
        </Grid.Clip>
        <Grid>
            <Image Source="pack://application:,,,/assets/brand/splitaria-splash-art-neutral-v1.png"
                   Stretch="UniformToFill" />
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#B8181927" Offset="0" />
                        <GradientStop Color="#7A20243A" Offset="0.43" />
                        <GradientStop Color="#12182035" Offset="0.72" />
                        <GradientStop Color="#00182035" Offset="1" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid Margin="38,30,38,28">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Width="270" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Width="76" Height="76" HorizontalAlignment="Left" Background="#28FFFFFF" CornerRadius="18" Margin="0,0,0,18">
                        <Image Width="58" Height="58" Source="pack://application:,,,/assets/brand/splitaria-mark-256.png" />
                    </Border>
                    <TextBlock Text="Splitaria" FontFamily="Segoe UI" FontSize="32" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Organize suas memórias." Margin="1,7,0,0" FontFamily="Segoe UI"
                               FontSize="14" Foreground="#E2E1EB" />
                    <TextBlock Text="Preparando fotos e vídeos…" Margin="1,25,0,0" FontFamily="Segoe UI"
                               FontSize="12" Foreground="#C3C2D0" />
                </StackPanel>
                <TextBlock Text="0.18.7" HorizontalAlignment="Right" VerticalAlignment="Top"
                           FontFamily="Segoe UI" FontSize="11" Foreground="#D0CFDA" />

                <Border Grid.Row="1" Width="270" Height="6" HorizontalAlignment="Left" Margin="0,18,0,0"
                        Background="#42FFFFFF" CornerRadius="3" ClipToBounds="True">
                    <Rectangle Width="96" HorizontalAlignment="Left" RadiusX="3" RadiusY="3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#8B7CFF" Offset="0" />
                                <GradientStop Color="#48D8EE" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                        <Rectangle.RenderTransform><TranslateTransform x:Name="LoadingTransform" X="-96" /></Rectangle.RenderTransform>
                        <Rectangle.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="LoadingTransform" Storyboard.TargetProperty="X"
                                                         From="-96" To="270" Duration="0:0:1.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Rectangle.Triggers>
                    </Rectangle>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
